# rcon function for base mcrcon calls, uses env vars and one input argument (the mc server command to be executed)
rcon() {
	"$MCRCON" \
		-H "$RCON_HOST" \
		-p "$RCON_PASSWORD" \
		"$1"
}

# List number of users on the server along with their usernames, calls to rcon function with list passed as argument
list() {
	rcon 'list'
}

# Send a message to all users on the server as server, calls to rcon function with defined "tellall" tellraw passed as argument, OPTS var is passed
# via cli and defines the message itself
tellall() {
	rcon 'tellraw @a {"text":"[Server] ","bold":true,"color":"gold", \"extra":[{"text":"'${TEXT}'","color":"yellow","bold":false,"italic":true}]}'
	STATUS=$?
	if [ "$STATUS" = 1 ]; then
		printf '%s\n' "$TEXT"
		return 0
	else
		return 1
	fi
}

# Waits for the user to press any number of characters followed by a terminating character
wait_for_user() {
	read X
}

grant_only_advancement() {
	rcon "advancement grant ${TARGET} only ${RESOURCE_LOCATION}"
	STATUS=$?
}

grant_every_advancement() {
	rcon "advancement grant ${TARGET} everything"
}

revoke_only_advancement() {
	rcon "advancement revoke ${TARGET} only ${RESOURCE_LOCATION}"
}

revoke_every_advancement() {
	rcon "advancement revoke ${TARGET} everything"
}

grant_advancement_criterion() {
	rcon "advancement grant ${TARGET} only ${RESOURCE_LOCATION} ${CRITERION_RESOURCE_LOCATION}"
}

revoke_advancement_criterion() {
	rcon "advancement revoke ${TARGET} only ${RESOURCE_LOCATION} ${CRITERION_RESOURCE_LOCATION}"
}

grant_child_advancements() {
	rcon "advancement grant ${TARGET} from ${RESOURCE_LOCATION}"
}

grant_parent_advancements() {
	rcon "advancement grant ${TARGET} until ${RESOURCE_LOCATION}"
}

grant_child_and_parent_advancements() {
	rcon "advancement grant ${TARGET} through ${RESOURCE_LOCATION}"
}
