grant_revoke_menu_abstract() {	
	clear 
	printf "Input target player username (or player target selector): "
	read TARGET
	if [ "$2" != "everything" ]; then
		printf "Input target resource location: "
		read RESOURCE_LOCATION
		OUTPUT=$(advancements_function "$1" "$TARGET" "$2" "$RESOURCE_LOCATION" 2>&1)
	else
		OUTPUT=$(advancements_function "$1" "$TARGET" "$2" 2>&1)
		
	fi
	printf '%s\n' "$OUTPUT"
	wait_for_user
}


only_advancement() {
	rcon "advancement ${ACTION_TYPE} ${TARGET} only ${RESOURCE_LOCATION}"
	STATUS=$?
}

every_advancement() {
	rcon "advancement ${ACTION_TYPE} ${TARGET} everything"
}

advancement_criterion() {
	rcon "advancement ${ACTION_TYPE} ${TARGET} only ${RESOURCE_LOCATION} ${CRITERION_RESOURCE_LOCATION}"
}

child_advancements() {
	rcon "advancement ${ACTION_TYPE} ${TARGET} from ${RESOURCE_LOCATION}"
}

parent_advancements() {
	rcon "advancement ${ACTION_TYPE} ${TARGET} until ${RESOURCE_LOCATION}"
}

child_and_parent_advancements() {
	rcon "advancement ${ACTION_TYPE} ${TARGET} through ${RESOURCE_LOCATION}"
}


advancements_function() {
	CMD_STR="advancement $1 $2 $3"
	if [ "$3" != "everything" ]; then
		CMD_STR="$CMD_STR $4"

		if [ -n "$5" ]; then
			CMD_STR="$CMD_STR $5"
		fi
	fi
	rcon "${CMD_STR}"
}
